#!name=𝑪𝒐𝒖𝒏𝒕𝒅𝒐𝒘𝒏
#!desc=节假日倒计时
#!category=𝑷𝒂𝒏𝒆𝒍

[Panel]
节假日倒计时 = script-name=节假日倒计时,update-interval=600
[Script]
节假日倒计时 = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/JupiterH/Surge/main/Scripts/Timecard.js
# 每天 8 点跑一次，保证节日当天不打开面板也能收到通知（脚本自己去重，一天只发一次）
节假日提醒 = type=cron,cronexp="0 8 * * *",timeout=10,script-path=https://raw.githubusercontent.com/JupiterH/Surge/main/Scripts/Timecard.js
