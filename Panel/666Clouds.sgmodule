#!name=666Clouds
#!desc = 监控六六云 VPS 剩余流量、已用流量和重置时间
#!category= 𝑷𝒂𝒏𝒆𝒍
#!arguments=id,cookie,ip,icon:xserve,icon-color:3B82F6,ip-mode:mask
#!arguments-desc=官网: 666clouds.com\n\n实例 ID 获取方式: \n    ├ 1.登录控制台进入实例详情\n    └ 2.网页链接“/portal/services/”后的数字即为ID\nCookie 获取方式: \n    ├ 1.浏览器登录 666clouds.com\n    ├ 2.打开开发者工具 → 网络，刷新实例详情页\n    └ 3.复制请求头中的 Cookie 整段\n    Cookie 只填在本机模块参数里，不要提交到仓库；留空则读取本机存储 666clouds_cookie\nip: 留空自动从页面识别，识别不到时手动填写\nicon: SF Symbol 名称\nicon-color: 6位HEX(不含#)\nip-mode: \n    ├ full\n    ├ mask\n    └ hide

[Panel]
666Clouds 流量信息 = title="666Clouds Server",content="正在获取...",style=info,script-name=666clouds-info-panel,update-interval=3600

[Script]
666clouds-info-panel = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/JupiterH/Surge/main/Scripts/666.js,argument="id={{{id}}}&cookie={{{cookie}}}&ip={{{ip}}}&icon={{{icon}}}&icon-color={{{icon-color}}}&ip-mode={{{ip-mode}}}"
