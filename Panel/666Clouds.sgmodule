#!name=666Clouds
#!desc = 监控六六云 VPS 流量信息和限速状态
#!category= 𝑷𝒂𝒏𝒆𝒍
#!arguments=token:"",id:"",ip:"",icon:xserve,icon-color:3B82F6,ip-mode:mask
#!arguments-desc=官网: 666clouds.com\n\nAPI Token 获取方式: \n    ├ 1.登录客户中心\n    ├ 2.进入“我的账户” → “流量 API”\n    └ 3.创建密钥(只读, 只在创建时显示一次)\nid: 服务编号, 留空则取名下第一台服务器\n    └ 实例详情网页链接“/portal/services/”后的数字\nip: 服务器 IP, 用于显示 IP 和地区, 留空则不显示\nip-mode: \n    ├ full\n    ├ mask\n    └ hide

[Panel]
666Clouds 流量信息 = title="666Clouds Server",content="正在获取...",style=info,script-name=666clouds-info-panel,update-interval=3600

[Script]
666clouds-info-panel = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/JupiterH/Surge/main/Scripts/666.js,argument="token={{{token}}}&id={{{id}}}&ip={{{ip}}}&icon={{{icon}}}&icon-color={{{icon-color}}}&ip-mode={{{ip-mode}}}"
