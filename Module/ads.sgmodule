[Script]
# 淘宝
淘宝-移除淘宝开屏广告 = type=http-response, pattern=^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(cloudvideo\.video\.query|wireless\.home\.splash\.awesome\.get), requires-body=1, script-path=https://kelee.one/Resource/JavaScript/Taobao/Taobao_remove_ads.js
淘宝-移除淘宝开屏广告2 = type=http-response, pattern=^https:\/\/poplayer\.template\.alibaba\.com\/\w+\.json, requires-body=1, script-path=https://kelee.one/Resource/JavaScript/Taobao/Taobao_remove_ads.js

# 京东
京东-移除京东广告 = type=http-response, pattern=^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome), requires-body=1, script-path=https://kelee.one/Resource/JavaScript/JD/JD_remove_ads.js

# 彩云天气
彩云天气-彩云天气去广告 = type=http-response, pattern=^https:\/\/(wrapper\.cyapi\.cn|api\.caiyunapp\.com|cdn-w\.caiyunapp\.com)\/v1\/activity\?, requires-body=1, script-path=https://kelee.one/Resource/JavaScript/ColorfulClouds/ColorfulClouds_remove_ads.js

# 小象超市
小象超市-移除下发广告 = type=http-response, pattern=^https:\/\/portal-portm\.meituan\.com\/horn_ios\/mergeRequest, requires-body=1, script-path=https://kelee.one/Resource/JavaScript/iMaiCai/iMaiCai_remove_ads.js

# 12306
12306-移除12306应用内广告 = type=http-request, pattern=^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$, script-path=https://kelee.one/Resource/JavaScript/12306/12306_remove_ads.js

