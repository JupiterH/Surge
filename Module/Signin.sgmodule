#!name = 𝑺𝒊𝒈𝒏 𝑰𝒏
#!desc = 签到脚本合集
#!category = 𝑭𝒖𝒏𝒄𝒕𝒊𝒐𝒏𝒂𝒍 𝑴𝒐𝒅𝒖𝒍𝒆𝒔

[Script]
# 阿里云盘签到（要重新抓 cookie 时：取消下一行的注释，并把 auth.alipan.com 加回 [MITM]）
#阿里云盘签到cookie = requires-body=1,type=http-response,pattern=https:\/\/auth.(aliyundrive|alipan).com\/v2\/account\/token,script-path=https://raw.githubusercontent.com/lowking/Scripts/master/ali/aliYunPanCheckIn.js
阿里云盘签到 = type=cron,cronexp="0 10 0 * * ?",wake-system=1,script-path=https://raw.githubusercontent.com/lowking/Scripts/master/ali/aliYunPanCheckIn.js

# 达美乐签到（已停用。脚本来自 Sliverkiss，直接引用上游；启用时把 game.dominos.com.cn 加回 [MITM]）
# 达美乐披萨获取token = type=http-request, pattern=^https:\/\/game\.dominos\.com\.cn\/.+\/game\/gameDone, script-path=https://gist.githubusercontent.com/Sliverkiss/6b4da0d367d13790a9fd1d928c82bdf8/raw/dlm.js, requires-body=true, timeout=10
# 达美乐披萨 = type=cron, cronexp="30 10 * * *", script-path=https://gist.githubusercontent.com/Sliverkiss/6b4da0d367d13790a9fd1d928c82bdf8/raw/dlm.js, timeout=300

# Bing积分（已停用。启用时把 rewards.bing.com 加回 [MITM]）
#Bing积分cookie = requires-body=0,type=http-request,pattern=https:\/\/rewards\.bing\.com,script-path=https://raw.githubusercontent.com/lowking/Scripts/master/bing/bingPoint.js
#Bing积分 = type=cron,cronexp="0 10 0 * * ?",wake-system=1,script-path=https://raw.githubusercontent.com/lowking/Scripts/master/bing/bingPoint.js

[MITM]
# 现在启用的脚本都不需要解密。抓 cookie / token 时按上面的说明把对应域名加回来：
# hostname = %APPEND% auth.alipan.com, game.dominos.com.cn, rewards.bing.com
